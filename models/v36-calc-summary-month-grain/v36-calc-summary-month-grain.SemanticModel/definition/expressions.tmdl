/// Where the data is loaded from: parquet (the files in the release, as measured so far), parquet-nobuffer (the same files without Binary.Buffer), csv (the same data as CSV files in the releases data-1m-csv and data-10m-csv) or sql (the lakehouse SQL endpoint on F64)
expression SourceType = "parquet" meta [IsParameterQuery=true, List={"parquet", "parquet-nobuffer", "csv", "sql"}, DefaultValue="parquet", Type="Text", IsParameterQueryRequired=true]
	lineageTag: f5f2ae0e-f81b-40d8-88b4-b5267c868cad

	annotation PBI_ResultType = Text

/// SQL endpoint of the lakehouse that holds the data, used when SourceType is sql
expression SqlEndpoint = "vmxp7jph42futcd3awug4hd2s4-4wprdu2xzvtehntrrgr23avo2u.datawarehouse.fabric.microsoft.com" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]
	lineageTag: d9463f34-bc5d-4425-8576-251e8da4fd14

