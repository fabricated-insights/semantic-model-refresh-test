{
  "properties": {
    "description": "Started by harness/run_queue.py. Each queue entry is one notebook run: variant, targets, data_tag, source_type, clear_first, deploy_pro, task, cooldown_seconds. Sequential, so only one refresh runs at a time; a failed entry does not stop the next one. After each entry the pipeline waits cooldown_seconds.",
    "activities": [
      {
        "type": "ForEach",
        "typeProperties": {
          "isSequential": true,
          "items": {
            "value": "@pipeline().parameters.queue",
            "type": "Expression"
          },
          "activities": [
            {
              "type": "TridentNotebook",
              "typeProperties": {
                "notebookId": "f07571d4-a3f1-4397-87df-a8f21cf87f17",
                "workspaceId": "00000000-0000-0000-0000-000000000000",
                "parameters": {
                  "variant": {
                    "value": {
                      "value": "@item().variant",
                      "type": "Expression"
                    },
                    "type": "string"
                  },
                  "targets": {
                    "value": {
                      "value": "@item().targets",
                      "type": "Expression"
                    },
                    "type": "string"
                  },
                  "data_tag": {
                    "value": {
                      "value": "@item().data_tag",
                      "type": "Expression"
                    },
                    "type": "string"
                  },
                  "source_type": {
                    "value": {
                      "value": "@item().source_type",
                      "type": "Expression"
                    },
                    "type": "string"
                  },
                  "clear_first": {
                    "value": {
                      "value": "@item().clear_first",
                      "type": "Expression"
                    },
                    "type": "string"
                  },
                  "deploy_pro": {
                    "value": {
                      "value": "@item().deploy_pro",
                      "type": "Expression"
                    },
                    "type": "string"
                  },
                  "task": {
                    "value": {
                      "value": "@item().task",
                      "type": "Expression"
                    },
                    "type": "string"
                  },
                  "expected_commit": {
                    "value": {
                      "value": "@pipeline().parameters.expected_commit",
                      "type": "Expression"
                    },
                    "type": "string"
                  },
                  "pipeline_run_id": {
                    "value": {
                      "value": "@pipeline().RunId",
                      "type": "Expression"
                    },
                    "type": "string"
                  },
                  "harness_run_id": {
                    "value": {
                      "value": "@concat(utcNow('yyyyMMdd''T''HHmmss''Z'''), '-', split(item().variant, '-')[0], '-', substring(pipeline().RunId, 0, 4))",
                      "type": "Expression"
                    },
                    "type": "string"
                  }
                }
              },
              "policy": {
                "timeout": "0.12:00:00",
                "retry": 0,
                "retryIntervalInSeconds": 30,
                "secureInput": false,
                "secureOutput": false
              },
              "name": "refresh-harness",
              "dependsOn": []
            },
            {
              "type": "Wait",
              "typeProperties": {
                "waitTimeInSeconds": {
                  "value": "@max(1, item().cooldown_seconds)",
                  "type": "Expression"
                }
              },
              "name": "Cooldown",
              "dependsOn": [
                {
                  "activity": "refresh-harness",
                  "dependencyConditions": [
                    "Completed"
                  ]
                }
              ]
            }
          ]
        },
        "name": "Each queue entry",
        "dependsOn": []
      }
    ],
    "parameters": {
      "queue": {
        "type": "array",
        "defaultValue": []
      },
      "expected_commit": {
        "type": "string",
        "defaultValue": ""
      }
    }
  }
}